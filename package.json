{
  "name": "@inline0/tailwindphp-tooling",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26.12.0",
    "pnpm": ">=12.14.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:scripts": "node --test scripts/tests/*.test.ts",
    "docs:check": "node scripts/check-docs-content.ts",
    "generate:merge": "node scripts/generate-tailwind-merge.ts",
    "generate:utilities": "node scripts/generate-utility-parity.ts",
    "versions": "node scripts/update-tailwind.ts --check && node scripts/update-libs.ts --check && node scripts/update-plugins.ts --check",
    "generate:legacy": "node scripts/generate-legacy-parity.ts"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.5",
    "@types/node": "26.6.5",
    "effect": "4.0.5",
    "typescript": "7.0.2",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "esbuild": "0.27.7"
  }
}
